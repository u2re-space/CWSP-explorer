{
    "applicationId": "space.u2re.explorer",
    "applicationName": "CWSP Explorer",
    "description": "CWSP Explorer desktop host",
    "version": "1.0.0",
    "defaultMode": "window",
    "documentRoot": "/resources/",
    "url": "/",
    "enableServer": true,
    "enableNativeAPI": true,
    "tokenSecurity": "one-time",
    "nativeAllowList": [
        "app.*",
        "os.*",
        "filesystem.*",
        "window.*",
        "events.*",
        "debug.log"
    ],
    "modes": {
        "window": {
            "title": "CWSP Explorer",
            "width": 960,
            "height": 720,
            "minWidth": 480,
            "minHeight": 360,
            "center": true,
            "resizable": true,
            "enableInspector": true
        }
    },
    "cli": {
        "binaryName": "cwsp-explorer",
        "resourcesPath": "/resources/",
        "clientLibrary": "/resources/js/neutralino.js"
    }
}
